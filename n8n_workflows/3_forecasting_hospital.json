{
  "name": "PHARMVERS Forecasting & Hospital Agent",
  "nodes": [
    {
      "parameters": {
        "path": "v1/alerts/stockout",
        "options": {}
      },
      "id": "webhook-trigger-id",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 250]
    },
    {
      "parameters": {
        "jsCode": "const currentStock = $json.currentStock;\nconst dailyConsumption = $json.dailyConsumption;\nconst refillLeadTime = 8;\n\nconst daysOfSupply = currentStock / dailyConsumption;\nconst riskScore = daysOfSupply < refillLeadTime ? 1.0 : (daysOfSupply - refillLeadTime) / 30.0;\nconst stockoutProb = daysOfSupply < refillLeadTime ? 0.99 : Math.max(0, 1.0 - (daysOfSupply / 30.0));\n\nreturn {\n  json: {\n    molecule: $json.molecule,\n    urgency: daysOfSupply < 5 ? \"CRITICAL\" : \"WARNING\",\n    stockoutProb: stockoutProb,\n    targetQty: 50000\n  }\n};"
      },
      "id": "code-forecast-id",
      "name": "Code Node (Euler Method Simulation)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [300, 250]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.stockoutProb }}",
              "operation": "largerEqual",
              "value2": 0.85
            }
          ]
        }
      },
      "id": "if-risk-id",
      "name": "IF Node (Risk Threshold Gate)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 250]
    },
    {
      "parameters": {
        "workflowId": "PdYjVxpVJjpN2EjC"
      },
      "id": "exec-procure-trigger-id",
      "name": "Execute Workflow (Procurement Trigger)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [750, 150]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Code Node (Euler Method Simulation)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code Node (Euler Method Simulation)": {
      "main": [
        [
          {
            "node": "IF Node (Risk Threshold Gate)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Node (Risk Threshold Gate)": {
      "main": [
        [
          {
            "node": "Execute Workflow (Procurement Trigger)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "forecasting-v1"
}
